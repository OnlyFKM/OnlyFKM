# Set to "live" to pull from a public ransomware-tracking feed instead of the
# bundled demo dataset. Leave unset (or anything else) to use demo data.
RANSOM_DATA_SOURCE=seed

# Base URL of the feed used by RANSOM_DATA_SOURCE=live. Verify the exact
# endpoints/response shape against the provider's current docs before
# relying on this in production — see src/lib/providers/liveFeedProvider.ts.
RANSOM_FEED_BASE_URL=https://api.ransomware.live/v2
